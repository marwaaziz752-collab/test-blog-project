---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/index.html';
const isBlog = currentPath.startsWith('/blog');
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo/Brand -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="p-2 rounded-xl bg-indigo-600 text-white transition-all duration-300 group-hover:bg-indigo-700 shadow-md shadow-indigo-100">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.63 8.31m5.96 6.06a14.98 14.98 0 0 1-6.16 12.12 14.98 14.98 0 0 1-3.84-12.12m5.96 6.06L9.63 8.31m0 0L5.43 13.65m4.2-5.34L1.39 9.25m4.04 4.4L1.39 9.25m0 0c-.5-1.2.14-2.7 1.5-2.7h11.23c1.36 0 2 .5 1.5 2.7l-4.2 5.34c-.5 1.2-2.14 1.2-2.64 0L1.39 9.25Z" />
          </svg>
        </span>
        <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-slate-900 to-indigo-950 bg-clip-text text-transparent">
          AstroSphere
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        <a
          href="/"
          class={`text-sm font-semibold transition-colors duration-200 hover:text-indigo-600 ${isHome ? 'text-indigo-600' : 'text-slate-600'}`}
        >
          Home
        </a>
        <a
          href="/blog"
          class={`text-sm font-semibold transition-colors duration-200 hover:text-indigo-600 ${isBlog ? 'text-indigo-600' : 'text-slate-600'}`}
        >
          Blog
        </a>
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 shadow-lg shadow-indigo-100 transition-all duration-200"
        >
          Get Started
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        id="mobile-menu-button"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div class="hidden md:hidden border-b border-slate-100 bg-white" id="mobile-menu">
    <div class="px-4 pt-2 pb-4 space-y-2">
      <a
        href="/"
        class={`block px-3 py-2.5 rounded-xl text-base font-semibold ${isHome ? 'bg-indigo-50/50 text-indigo-600 font-bold' : 'text-slate-600 hover:bg-slate-50'}`}
      >
        Home
      </a>
      <a
        href="/blog"
        class={`block px-3 py-2.5 rounded-xl text-base font-semibold ${isBlog ? 'bg-indigo-50/50 text-indigo-600 font-bold' : 'text-slate-600 hover:bg-slate-50'}`}
      >
        Blog
      </a>
      <div class="pt-2">
        <a
          href="/blog"
          class="block w-full text-center px-4 py-3 rounded-xl text-base font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-100"
        >
          Get Started
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
