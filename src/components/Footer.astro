---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8">
      <!-- Brand & Description -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <span class="p-2 rounded-xl bg-indigo-600 text-white shadow-md shadow-indigo-900/30">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.63 8.31m5.96 6.06a14.98 14.98 0 0 1-6.16 12.12 14.98 14.98 0 0 1-3.84-12.12m5.96 6.06L9.63 8.31m0 0L5.43 13.65m4.2-5.34L1.39 9.25m4.04 4.4L1.39 9.25m0 0c-.5-1.2.14-2.7 1.5-2.7h11.23c1.36 0 2 .5 1.5 2.7l-4.2 5.34c-.5 1.2-2.14 1.2-2.64 0L1.39 9.25Z" />
            </svg>
          </span>
          <span class="text-xl font-extrabold tracking-tight text-white">
            AstroSphere
          </span>
        </div>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed">
          A high-performance modern space for learning, sharing, and creating web applications with speed and style. Empowering developers and creators.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold tracking-wider text-slate-100 uppercase">Navigation</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-white transition-colors duration-200">Home</a>
          </li>
          <li>
            <a href="/blog" class="hover:text-white transition-colors duration-200">Blog</a>
          </li>
          <li>
            <a href="/blog" class="hover:text-white transition-colors duration-200">Get Started</a>
          </li>
        </ul>
      </div>

      <!-- Socials / Connect -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold tracking-wider text-slate-100 uppercase">Connect</h4>
        <div class="flex gap-4">
          <!-- Twitter/X -->
          <a href="#" aria-label="Twitter Profile" class="p-2.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-all duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </a>
          <!-- GitHub -->
          <a href="#" aria-label="GitHub Repository" class="p-2.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-all duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href="#" aria-label="LinkedIn Profile" class="p-2.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-all duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Divider & Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {currentYear} AstroSphere. All rights reserved.</p>
      <p>Clean. Modern. Ready for Pages CMS.</p>
    </div>
  </div>
</footer>
