---
interface Props {
  title: string;
  author: string;
  pubDate: Date;
  image: string;
  tags: string[];
  description: string;
  slug: string;
}

const { title, author, pubDate, image, tags, description, slug } = Astro.props;

// Format Date nicely
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group flex flex-col h-full bg-white rounded-3xl border border-slate-100 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">

  <!-- Image Wrapper -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-100">
    <img
      src={image}
      alt={`Cover image for ${title}`}
      class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <!-- Tags Overlay -->
    <div class="absolute top-4 left-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="px-2.5 py-1 text-xs font-bold text-indigo-700 bg-white/95 backdrop-blur-md rounded-lg shadow-sm">
          #{tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Content Card -->
  <div class="flex flex-col flex-grow p-6 sm:p-8 space-y-4">
    <!-- Meta Data -->
    <div class="flex items-center gap-2.5 text-xs font-semibold text-slate-500">
      <span>{author}</span>
      <span class="h-1 w-1 rounded-full bg-slate-300"></span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 group-hover:text-indigo-600 transition-colors duration-200 line-clamp-2">
      <a href={`/blog/${slug}`}>
        {title}
      </a>
    </h3>

    <!-- Excerpt / Description -->
    <p class="text-slate-600 text-sm leading-relaxed line-clamp-3 flex-grow">
      {description}
    </p>

    <!-- Bottom Action -->
    <div class="pt-2">
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center text-sm font-bold text-indigo-600 group-hover:text-indigo-700 group-hover:underline transition-all duration-200"
      >
        Read More
        <svg class="w-4 h-4 ml-1.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>

</article>
