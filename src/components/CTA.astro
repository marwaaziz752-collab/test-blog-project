---
---

<section class="py-16 sm:py-24 bg-white relative overflow-hidden">
  <!-- Soft background shapes -->
  <div class="absolute -top-24 -left-24 h-72 w-72 bg-indigo-50/50 rounded-full blur-2xl -z-10"></div>
  <div class="absolute -bottom-24 -right-24 h-72 w-72 bg-violet-50/50 rounded-full blur-2xl -z-10"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-gradient-to-br from-indigo-900 to-indigo-950 text-white rounded-3xl p-8 sm:p-12 md:p-16 overflow-hidden shadow-2xl shadow-indigo-950/20">

      <!-- Ambient light effect -->
      <div class="absolute top-0 right-0 h-64 w-64 bg-indigo-500/10 rounded-full blur-3xl"></div>

      <div class="relative z-10 max-w-2xl mx-auto text-center space-y-6 sm:space-y-8">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight">
          Ready to Explore More Amazing Content?
        </h2>

        <p class="text-indigo-200 text-base sm:text-lg leading-relaxed max-w-lg mx-auto">
          We post weekly updates about web technologies, UI/UX designs, CMS integrations, and modern development tips.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="/blog"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold text-indigo-950 bg-white hover:bg-slate-100 active:bg-slate-200 transition-all duration-200 shadow-xl shadow-indigo-950/35 hover:shadow-indigo-950/45 transform hover:-translate-y-0.5"
          >
            Visit Our Blog
            <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="#about"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold text-white border border-indigo-500/50 hover:bg-white/10 active:bg-white/20 transition-all duration-200"
          >
            About AstroSphere
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
