---
interface Props {
  title: string;
  tagline: string;
  description: string;
  ctaText: string;
  ctaLink: string;
}

const { title, tagline, description, ctaText, ctaLink } = Astro.props;
---

<section class="relative overflow-hidden bg-white pt-24 pb-20 sm:pt-32 sm:pb-28 lg:pt-40 lg:pb-36 border-b border-slate-100">
  <!-- Glowing background blobs -->
  <div class="absolute -top-40 -right-40 -z-10 h-[400px] w-[400px] rounded-full bg-indigo-50 blur-3xl opacity-80 sm:-top-60 sm:-right-60 sm:h-[600px] sm:w-[600px]"></div>
  <div class="absolute -bottom-40 -left-40 -z-10 h-[400px] w-[400px] rounded-full bg-violet-50 blur-3xl opacity-80 sm:-bottom-60 sm:-left-60 sm:h-[600px] sm:w-[600px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center max-w-3xl mx-auto space-y-8">

      <!-- Premium Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 border border-indigo-100/60 shadow-sm text-xs sm:text-sm font-semibold text-indigo-700 animate-fade-in">
        <span class="flex h-2 w-2 rounded-full bg-indigo-600 animate-pulse"></span>
        {tagline}
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1] sm:leading-[1.15]">
        {title.split(' ').slice(0, -2).join(' ')} <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">{title.split(' ').slice(-2).join(' ')}</span>
      </h1>

      <!-- Description -->
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto font-medium">
        {description}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href={ctaLink}
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold text-white bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 shadow-xl shadow-indigo-100 hover:shadow-indigo-200 transition-all duration-300 transform hover:-translate-y-0.5"
        >
          {ctaText}
          <svg class="w-5 h-5 ml-2.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="#about"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 transition-all duration-300"
        >
          Learn More
        </a>
      </div>

    </div>
  </div>
</section>
