---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';

// Fetch the 3 most recent blog posts
const posts = await getCollection('blog');
const latestPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div class="max-w-xl space-y-3.5">
        <h2 class="text-xs font-bold tracking-widest text-indigo-600 uppercase">
          Fresh Insights
        </h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          Latest Blog Posts
        </p>
        <p class="text-slate-600 font-medium">
          Read our most popular articles, guides, and tech tips written by our creative contributors.
        </p>
      </div>
      <div>
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-indigo-600 bg-white border border-slate-200/80 hover:bg-slate-50 shadow-sm active:bg-slate-100 transition-all duration-200"
        >
          View All Posts
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {latestPosts.map((post) => (
        <BlogCard
          title={post.data.title}
          author={post.data.author}
          pubDate={post.data.pubDate}
          image={post.data.image}
          tags={post.data.tags}
          description={post.data.description}
          slug={post.id}
        />
      ))}
    </div>

  </div>
</section>
