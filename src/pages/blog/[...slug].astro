---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

// Generate dynamic paths for all blog posts
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// Get the specific post from props
const { post } = Astro.props;
const { Content, headings } = await render(post);

// 1. Reading Time / Word Count Calculation
const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTimeMinutes = Math.max(1, Math.round(wordCount / 200));
const readingTimeText = `${readingTimeMinutes} min read`;

// 2. Table of Contents Sidebar Filtering (H2 and H3 only)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 3. SEO Meta Fields Support
const pageTitle = post.data.metaTitle && post.data.metaTitle.trim() !== ''
  ? post.data.metaTitle
  : `${post.data.title} | AstroSphere Blog`;

const pageDescription = post.data.metaDescription && post.data.metaDescription.trim() !== ''
  ? post.data.metaDescription
  : post.data.description;

// Format Publication Date nicely
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <article class="bg-white min-h-screen">

    <!-- Hero Header / Post Cover Area -->
    <header class="relative py-16 sm:py-24 bg-slate-50 border-b border-slate-100 overflow-hidden">
      <div class="absolute -top-32 left-10 h-72 w-72 bg-indigo-50 rounded-full blur-3xl -z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative space-y-6">

        
          href="/blog"
          class="inline-flex items-center text-sm font-bold text-slate-500 hover:text-indigo-600 transition-colors duration-200"
        >
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Blog
        </a>

        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-100/50 rounded-xl">
              #{tag}
            </span>
          ))}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-md">
              {post.data.author.charAt(0)}
            </div>
            <div class="text-xs sm:text-sm">
              <p class="font-bold text-slate-900">{post.data.author}</p>
              <p class="text-slate-500 font-medium">Published on <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time></p>
            </div>
          </div>

          <span class="hidden sm:inline h-5 w-px bg-slate-300"></span>

          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-indigo-50/80 text-xs sm:text-sm font-bold text-indigo-700">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span>{readingTimeText} ({wordCount} words)</span>
          </div>
        </div>

      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      {tocHeadings.length > 0 && (
        <div class="block lg:hidden mb-8 border border-slate-200 rounded-2xl bg-slate-50/50 overflow-hidden">
          <button
            type="button"
            class="flex items-center justify-between w-full p-4 font-bold text-slate-900 text-sm hover:bg-slate-100 transition-colors duration-200"
            id="mobile-toc-toggle"
          >
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-indigo-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12M8.25 17.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-3.75 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
              Table of Contents
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-slate-500 transition-transform duration-300" id="mobile-toc-arrow">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div class="hidden border-t border-slate-200 p-4 bg-white" id="mobile-toc-menu">
            <nav class="space-y-2">
              {tocHeadings.map((heading) => (
                
                  href={`#${heading.slug}`}
                  class={`block text-xs font-semibold hover:text-indigo-600 transition-colors duration-200 ${heading.depth === 3 ? 'pl-4 text-slate-500' : 'text-slate-800'}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-12 items-start">

        <div class="lg:col-span-3 space-y-12">

          <div class="aspect-[16/9] w-full overflow-hidden rounded-3xl bg-slate-100 shadow-md relative">
            <Image
              src={post.data.image}
              alt={`Featured cover for ${post.data.title}`}
              width={1200}
              height={675}
              format="webp"
              class="object-cover w-full h-full"
            />
          </div>

          <div class="prose max-w-none" id="article-content">
            <Content />
          </div>

          <!-- FAQ Section (using structured faqs field) -->
          {post.data.faqs && post.data.faqs.length > 0 && (
            <div class="space-y-4 pt-8 border-t border-slate-100">
              <h2 class="text-2xl font-extrabold text-slate-900 mb-4">Frequently Asked Questions</h2>
              {post.data.faqs.map((faq) => (
                <div class="faq-accordion-item border border-slate-200 rounded-2xl bg-slate-50/30 overflow-hidden">
                  <button
                    type="button"
                    class="faq-trigger flex items-center justify-between w-full p-4 font-bold text-slate-950 text-sm sm:text-base hover:bg-slate-100 text-left transition-colors duration-200"
                  >
                    <span>{faq.question}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-indigo-600 shrink-0 ml-4 transition-transform duration-300 faq-arrow">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>
                  <div class="faq-content hidden border-t border-slate-100 p-4 bg-white text-slate-600 text-sm sm:text-base leading-relaxed">
                    {faq.answer}
                  </div>
                </div>
              ))}
            </div>
          )}

        </div>

        <aside class="hidden lg:block lg:col-span-1 sticky top-28 space-y-6">
          {tocHeadings.length > 0 && (
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm">
              <h3 class="text-xs font-bold tracking-widest text-slate-400 uppercase mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-indigo-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12M8.25 17.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-3.75 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
                Table of Contents
              </h3>
              <nav class="space-y-3 border-l border-slate-100 pl-4">
                {tocHeadings.map((heading) => (
                  
                    href={`#${heading.slug}`}
                    class={`block text-xs font-bold transition-all duration-200 hover:text-indigo-600 relative -ml-[17px] pl-4 border-l-2 border-transparent hover:border-indigo-600 ${heading.depth === 3 ? 'pl-8 -ml-[17px] text-slate-500 hover:text-indigo-600 font-semibold' : 'text-slate-800'}`}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <div class="bg-indigo-50/50 border border-indigo-100/30 rounded-3xl p-6 space-y-4">
            <h4 class="font-bold text-slate-900 text-sm">Need help or advice?</h4>
            <p class="text-slate-600 text-xs leading-relaxed">
              Contact our product team or read other curated articles to supercharge your web layouts!
            </p>
            
              href="/blog"
              class="inline-flex w-full items-center justify-center p-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-100 transition-all duration-200"
            >
              All Articles
            </a>
          </div>
        </aside>

      </div>

    </div>

  </article>
</Layout>

<script>
  const mobileTocToggle = document.getElementById('mobile-toc-toggle');
  const mobileTocMenu = document.getElementById('mobile-toc-menu');
  const mobileTocArrow = document.getElementById('mobile-toc-arrow');

  if (mobileTocToggle && mobileTocMenu && mobileTocArrow) {
    mobileTocToggle.addEventListener('click', () => {
      const isHidden = mobileTocMenu.classList.toggle('hidden');
      if (isHidden) {
        mobileTocArrow.classList.remove('rotate-180');
      } else {
        mobileTocArrow.classList.add('rotate-180');
      }
    });

    const mobileAnchors = mobileTocMenu.querySelectorAll('a');
    mobileAnchors.forEach(a => {
      a.addEventListener('click', () => {
        mobileTocMenu.classList.add('hidden');
        mobileTocArrow.classList.remove('rotate-180');
      });
    });
  }

  // FAQ Accordion Click Handler (for structured faqs field)
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-accordion-item');
      const content = item?.querySelector('.faq-content');
      const arrow = item?.querySelector('.faq-arrow');
      if (content && arrow) {
        const isHidden = content.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180', !isHidden);
      }
    });
  });
</script>

<style is:global>
  .prose {
    color: var(--color-slate-700);
    line-height: 1.8;
  }
  .prose h2, .prose h3 {
    color: var(--color-slate-950);
    font-weight: 800;
    margin-top: 2rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .prose h2 {
    font-size: 1.75rem;
    border-bottom: 1px solid var(--color-slate-100);
    padding-bottom: 0.5rem;
  }
  .prose h3 {
    font-size: 1.35rem;
  }
  .prose p {
    margin-bottom: 1.5rem;
  }
  .prose strong {
    color: var(--color-slate-950);
    font-weight: 700;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose pre {
    background-color: var(--color-slate-900);
    color: var(--color-slate-100);
    padding: 1.25rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .prose code {
    background-color: var(--color-slate-100);
    color: var(--color-slate-850);
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .prose pre code {
    background-color: transparent;
    color: inherit;
    padding: 0;
    font-weight: normal;
  }
  .prose li .faq-accordion-item {
    margin-left: 0 !important;
  }
</style>
