---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Generate dynamic paths for all blog posts
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// Get the specific post from props
const { post } = Astro.props;
const { Content } = await render(post);

// Format Publication Date nicely
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${post.data.title} | AstroSphere Blog`}
  description={post.data.description}
>
  <article class="bg-white min-h-screen">

    <!-- Hero Header / Post Cover Area -->
    <header class="relative py-16 sm:py-24 bg-slate-50 border-b border-slate-100 overflow-hidden">
      <!-- Glow ambient -->
      <div class="absolute -top-32 left-10 h-72 w-72 bg-indigo-50 rounded-full blur-3xl -z-10"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative space-y-6">

        <!-- Back Button -->
        <a
          href="/blog"
          class="inline-flex items-center text-sm font-bold text-slate-500 hover:text-indigo-600 transition-colors duration-200"
        >
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Blog
        </a>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-100/50 rounded-xl">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          {post.data.title}
        </h1>

        <!-- Author / Meta Info -->
        <div class="flex items-center gap-3 pt-2">
          <!-- Small initial avatar -->
          <div class="h-10 w-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-md">
            {post.data.author.charAt(0)}
          </div>
          <div class="text-xs sm:text-sm">
            <p class="font-bold text-slate-900">{post.data.author}</p>
            <p class="text-slate-500 font-medium">Published on <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time></p>
          </div>
        </div>

      </div>
    </header>

    <!-- Post Main Content Area -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

      <!-- Featured Image -->
      <div class="aspect-[16/9] w-full overflow-hidden rounded-3xl bg-slate-100 mb-12 shadow-md">
        <img
          src={post.data.image}
          alt={`Featured cover for ${post.data.title}`}
          class="object-cover w-full h-full"
        />
      </div>

      <!-- Article Body with modern typography and styling -->
      <div class="prose max-w-3xl mx-auto px-0 md:px-4">
        <Content />
      </div>

    </div>

  </article>
</Layout>

<style is:global>
  /* Standard modern prose layout adjustments since we're using raw Tailwind CSS */
  .prose {
    color: var(--color-slate-700);
    line-height: 1.8;
  }
  .prose h2, .prose h3 {
    color: var(--color-slate-950);
    font-weight: 800;
    margin-top: 2rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .prose h2 {
    font-size: 1.75rem;
    border-bottom: 1px solid var(--color-slate-100);
    padding-bottom: 0.5rem;
  }
  .prose h3 {
    font-size: 1.35rem;
  }
  .prose p {
    margin-bottom: 1.5rem;
  }
  .prose strong {
    color: var(--color-slate-950);
    font-weight: 700;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose pre {
    background-color: var(--color-slate-900);
    color: var(--color-slate-100);
    padding: 1.25rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .prose code {
    background-color: var(--color-slate-100);
    color: var(--color-slate-850);
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .prose pre code {
    background-color: transparent;
    color: inherit;
    padding: 0;
    font-weight: normal;
  }
</style>
